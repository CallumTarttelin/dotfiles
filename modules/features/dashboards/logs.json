{
  "uid": "logs-overview",
  "title": "Logs Overview",
  "tags": ["logs", "loki"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "host", "stream": "" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "unit",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "unit", "stream": "{host=~\"$host\"}" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Log Volume",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 40,
            "stacking": { "mode": "normal" },
            "drawStyle": "bars"
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({host=~\"$host\", unit=~\"$unit\"} [1m]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": { "mode": "normal" },
            "drawStyle": "bars"
          },
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "targets": [
        {
          "expr": "sum by (unit) (count_over_time({host=~\"$host\", unit=~\"$unit\", level=~\"3|4\"} [1m]))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "title": "Logs",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{host=~\"$host\", unit=~\"$unit\"}",
          "legendFormat": ""
        }
      ]
    }
  ],
  "schemaVersion": 39
}
